STEP 10 — Retrieval
def retrieve_docs(question):

    q_vector = embed_text(question)

    response = client.search(
        index='lks2026-knowledge',
        body={
            "size":3,
            "query":{
                "knn":{
                    "vector":{
                        "vector": q_vector,
                        "k":3
                    }
                }
            }
        }
    )

    docs = []

    for hit in response["hits"]["hits"]:
        docs.append(hit["_source"]["text"])

    return docs
STEP 11 — Generate Jawaban
def ask_rag(question):

    docs = retrieve_docs(question)

    context = "\n".join(docs)

    prompt = f"""
Context:
{context}

Question:
{question}

Answer:
"""

    response = bedrock.invoke_model(
        modelId="anthropic.claude-3-haiku-20240307-v1:0",
        body=json.dumps({
            "anthropic_version":"bedrock-2023-05-31",
            "max_tokens":1000,
            "messages":[
                {
                    "role":"user",
                    "content":prompt
                }
            ]
        })
    )

    result = json.loads(
        response["body"].read()
    )

    return result["content"][0]["text"]

