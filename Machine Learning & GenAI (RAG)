Deteksi label:

def detect_labels(bucket,key):

    response = rekognition.detect_labels(
        Image={
            "S3Object":{
                "Bucket":bucket,
                "Name":key
            }
        },
        MaxLabels=10
    )

    return response["Labels"]
STEP 6 — OCR
def detect_text(bucket,key):

    response = rekognition.detect_text(
        Image={
            "S3Object":{
                "Bucket":bucket,
                "Name":key
            }
        }
    )

    texts=[]

    for item in response["TextDetections"]:
        if item["Type"]=="LINE":
            texts.append(item["DetectedText"])

    return texts
STEP 7 — Simpan ke DynamoDB
table.put_item(
    Item={
        "image_name":key,
        "labels":labels,
        "texts":texts
    }
)
STEP 8 — Lambda Handler
def lambda_handler(event, context):

    bucket = event['Records'][0]['s3']['bucket']['name']

    key = event['Records'][0]['s3']['object']['key']

    labels = detect_labels(bucket,key)

    texts = detect_text(bucket,key)

    table.put_item(
        Item={
            "image_name":key,
            "labels":labels,
            "texts":texts
        }
    )

    return {
        "statusCode":200
    }
